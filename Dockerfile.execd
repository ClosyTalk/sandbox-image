# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# Retain only the unchanged static bubblewrap from the immutable upstream image.
FROM opensandbox/execd:v1.0.20@sha256:84ed968d48065768fd7e39238020fdf8e7445510896382df45fb2f4d84be942e AS upstream-assets

FROM golang:1.27.3-alpine3.24@sha256:d530cf60723abf1ffae0cd16bb546b379ec0550d2f3815e5b16ed69dbc00fba4 AS builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
# docker/execd/v1.0.20, resolved in alibaba/OpenSandbox; checksum covers the full archive.
ADD --checksum=sha256:a3caeab756e3a95adca32ee0191450f6320d88f9fcd12424e2c53378fdb7aeeb \
    https://codeload.github.com/alibaba/OpenSandbox/tar.gz/ae452d4af7b6415b5074fd7e075b97ff7a5ac236 /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 && rm /tmp/source.tar.gz
# Minimum versions fixing the reviewed advisories. MVS also advances their required
# dependencies (notably x/crypto to v0.57.0, x/sys to v0.48.0 and x/text to v0.42.0).
WORKDIR /build/components/internal
RUN go get go.opentelemetry.io/otel/sdk@v1.45.0 golang.org/x/net@v0.60.0 google.golang.org/grpc@v1.83.2 \
    && go mod tidy && go mod verify
WORKDIR /build/components/execd
RUN go get golang.org/x/crypto@v0.57.0 golang.org/x/net@v0.60.0 \
        google.golang.org/grpc@v1.83.2 go.opentelemetry.io/otel/sdk@v1.45.0 \
    && go mod tidy && go mod verify
# Test prerequisites only; these packages never enter the runtime image.
RUN apk add --no-cache bash patch
# Upstream incorrectly expects the legacy open syscall on arm64. Exercise openat,
# available on both architectures, keeping every known/unknown filtering assertion.
COPY execd-tests.patch /tmp/execd-tests.patch
RUN patch -p1 -d /build < /tmp/execd-tests.patch
# Match upstream CI's unprivileged test user: its default-UID tests expect setpriv
# in generated argv, which production correctly omits when the caller is root.
RUN adduser -D -u 10001 builder && chown -R builder:builder /build /go
USER builder
# Run the complete upstream suites, including the shared local module, on the target
# architecture. CI uses native runners for both architectures; failures block the build.
RUN cd /build/components/internal && go test ./... && go vet ./...
RUN go test ./... && go vet ./...
RUN go build -trimpath -buildvcs=false \
    -ldflags "-buildid= -B none \
      -X github.com/alibaba/opensandbox/internal/version.Version=docker/execd/v1.0.20 \
      -X github.com/alibaba/opensandbox/internal/version.BuildTime=unknown \
      -X github.com/alibaba/opensandbox/internal/version.GitCommit=ae452d4af7b6415b5074fd7e075b97ff7a5ac236" \
    -o /build/execd ./main.go

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
ARG IMAGE_VERSION=1.0.22
ARG SOURCE_REVISION=unknown
# Invalidate the package-refresh layer for weekly rebuilds without advancing any pin.
ARG APK_REFRESH=manual
RUN echo "Package refresh: ${APK_REFRESH}" && apk upgrade --no-cache \
    && rm -f /lib/apk/db/lock /var/log/apk.log
COPY --from=upstream-assets /usr/local/bin/bwrap /usr/local/bin/bwrap
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) checksum=2eac825be98626a3a7e8daf17afdedcb65560951cb26ffaecea261f5686acb28 ;; \
      arm64) checksum=0fc274e60c4b606db202dc9e82db60b4d944ba74bab8b6af2cd95ea28c4f8b2d ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && echo "$checksum  /usr/local/bin/bwrap" | sha256sum -c - \
    && rm -rf /root/.cache
COPY --from=builder --chown=0:0 --chmod=755 /build/execd /execd
COPY --from=builder --chown=0:0 --chmod=755 /build/components/execd/bootstrap.sh /bootstrap.sh
COPY --from=builder --chown=0:0 --chmod=644 /build/components/execd/install.bat /install.bat
LABEL keep-on-prune="true" \
    org.opencontainers.image.source="https://github.com/ClosyTalk/sandbox-image" \
    org.opencontainers.image.title="OpenSandbox execd with prune protection" \
    org.opencontainers.image.version="${IMAGE_VERSION}" \
    org.opencontainers.image.revision="${SOURCE_REVISION}" \
    org.opencontainers.image.base.name="alpine:3.24.2" \
    org.opencontainers.image.base.digest="sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6" \
    io.closytalk.execd.upstream.source="https://github.com/alibaba/OpenSandbox" \
    io.closytalk.execd.upstream.revision="ae452d4af7b6415b5074fd7e075b97ff7a5ac236" \
    io.closytalk.execd.upstream.version="docker/execd/v1.0.20" \
    io.closytalk.execd.go.version="go1.27.3"
WORKDIR /
ENTRYPOINT ["./execd"]
